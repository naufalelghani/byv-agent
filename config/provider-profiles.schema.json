{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byv-agent.local/schemas/provider-profiles.schema.json",
  "title": "BYV Provider Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "endpointMode", "protocol", "baseUrlEnv", "modelIdEnv", "credentialEnv", "verificationStatus", "capabilities", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "endpointMode": { "enum": ["direct-api", "third-party-endpoint"] },
          "protocol": { "enum": ["anthropic-messages", "translated-anthropic-messages"] },
          "baseUrlEnv": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$" },
          "modelIdEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "credentialEnv": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"] }
          },
          "verificationStatus": { "enum": ["unverified", "endpoint-reachable", "messages-compatible", "agentic-verified"] },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["streaming", "toolUse", "agentTeams"],
            "properties": {
              "streaming": { "enum": ["unverified", "supported", "unsupported"] },
              "toolUse": { "enum": ["unverified", "supported", "unsupported"] },
              "agentTeams": { "enum": ["unverified", "supported", "unsupported"] }
            }
          },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "endpointMode": { "const": "direct-api" } }, "required": ["endpointMode"] },
            "then": { "properties": { "protocol": { "const": "anthropic-messages" } } }
          }
        ]
      }
    }
  }
}
